<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishProfileFullPath>$(MSBuildExtensionsPath)..\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\launchSettings.winapprunprofile.pubxml</PublishProfileFullPath>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Task 5: CsWinRT 2.3.1 is referenced for its WinRT.Runtime only. Its own
         cswinrt.exe projection step is disabled (it requires a registry-installed
         Windows SDK, which build agents may not have); the WebView2 projection
         keeps being generated by the WebView2 SDK's bundled wv2winrt.exe. -->
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YouTubeTvShell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Task 5: CsWinRT runtime must match the generator used for the WebView2
         projection. Without this pin the build resolves WinRT.Runtime 2.1.1 while
         SDK BuildTools generate a projection referencing GetVirtualMethodTableInfoForKey,
         crashing startup with TypeLoadException in XamlTypeInfoProvider.InitTypeTables. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
